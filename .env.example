# ==============================================================================
# MENTIS SANCTUARY — ENVIRONMENT VARIABLES SPECIFICATION
# Add these variables to your Vercel Project Settings > Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Authentication (Production Cloud Database)
# Find these in Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# (Alternative alias: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. Google SMTP Courier (Registration Notifications & Approvals)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# Note: Google 2-Step Verification must be enabled on your Google Account.
# ------------------------------------------------------------------------------
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-google-app-password
# (Alternative alias: SMTP_PASSWORD)
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM="Mentis Sanctuary <your-email@gmail.com>"
OWNER_EMAIL=your-email@gmail.com
ADMIN_EMAILS=your-email@gmail.com

# ------------------------------------------------------------------------------
# 3. AI Sanctuary & Arcane Vault Encryption
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
AI_CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
