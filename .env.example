# ==============================================================================
# MENTIS ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE / PUBLIC CONFIGURATION (Exposed to browser via NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=""

# Supabase Anonymous / Publishable Key (safe for client exposure; protected by Postgres RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# The public URL where this Mentis web application is hosted
APP_URL="https://mentis.app"

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER EXPOSE TO BROWSER / NEVER PREFIX WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Optional: Supabase Service Role Secret Key (for server-side privileged admin actions only)
SUPABASE_SERVICE_ROLE_KEY=""

# Google SMTP Email Configuration (Owner Notifications on New Registrations)
# Use your Google Account email and 16-character App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mentis Sanctuary <no-reply@mentis.academic>"

# The owner email address who receives registration review notifications
OWNER_EMAIL="abdullahsaeed.sam@gmail.com"

# Comma-separated list of administrator email addresses authorized for the Admin Area
ADMIN_EMAILS="abdullahsaeed.sam@gmail.com"

# 32-byte (256-bit) hexadecimal key for server-side AES-256-GCM encryption of user AI keys
AI_CREDENTIAL_ENCRYPTION_KEY=""

# Fallback Gemini API Key for server-side operations (optional if users provide Magical Key)
GEMINI_API_KEY=""
